{
  "info": {
    "_postman_id": "c8f9b76e-3491-4cfa-8947-f4e912301a22",
    "name": "Corridex — Multi-Corridor Freight Visibility Engine REST API",
    "description": "Enterprise-grade RESTful API collection for Corridex (formerly CargoTrace Global). Includes RBAC authentication via Laravel Sanctum, deterministic delay calculations, chronological tracking events, operational exceptions, and GIS route waypoints with point-in-time weather telemetry.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "shipment_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "exception_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Operator Demo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "} else if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operator@cargotrace.test\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Login (Admin Demo)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cargotrace.test\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Login (Customer Demo)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@cargotrace.test\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Current Authenticated User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/user",
              "host": ["{{base_url}}"],
              "path": ["user"]
            }
          }
        },
        {
          "name": "Logout (Revoke Sanctum Token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Shipments & Route Telemetry",
      "item": [
        {
          "name": "List Shipments (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/shipments?per_page=10&status=IN_TRANSIT",
              "host": ["{{base_url}}"],
              "path": ["shipments"],
              "query": [
                { "key": "per_page", "value": "10" },
                { "key": "status", "value": "IN_TRANSIT" }
              ]
            }
          }
        },
        {
          "name": "Create Consignment Booking (Admin/Operator)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 3,\n  \"carrier_id\": 1,\n  \"origin_location_id\": 1,\n  \"destination_location_id\": 3,\n  \"current_location_id\": 1,\n  \"cargo_type\": \"High-Value Semiconductor Components\",\n  \"total_weight_kg\": 12450.00,\n  \"total_volume_cbm\": 45.20,\n  \"expected_departure\": \"2026-11-15T08:00:00Z\",\n  \"expected_arrival\": \"2026-11-28T18:00:00Z\",\n  \"items\": [\n    {\n      \"sku\": \"SEMI-CHIP-7NM-A\",\n      \"item_name\": \"Advanced 7nm AI Accelerators\",\n      \"quantity\": 2400,\n      \"weight_kg\": 4800.00,\n      \"volume_cbm\": 18.00\n    },\n    {\n      \"sku\": \"SEMI-MOD-OPT-B\",\n      \"item_name\": \"Optical Transceiver Modules\",\n      \"quantity\": 1200,\n      \"weight_kg\": 7650.00,\n      \"volume_cbm\": 27.20\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/shipments",
              "host": ["{{base_url}}"],
              "path": ["shipments"]
            }
          }
        },
        {
          "name": "Get Shipment by ID (Includes GeoJSON Coordinates)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/shipments/{{shipment_id}}",
              "host": ["{{base_url}}"],
              "path": ["shipments", "{{shipment_id}}"]
            }
          }
        },
        {
          "name": "Get Shipment Maritime GIS Route & Telemetry",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/shipments/{{shipment_id}}/route",
              "host": ["{{base_url}}"],
              "path": ["shipments", "{{shipment_id}}", "route"]
            }
          }
        },
        {
          "name": "Update Shipment ETA & Recalculate SLA (Admin/Operator)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estimated_arrival\": \"2026-11-29T14:00:00Z\",\n  \"delay_reason\": \"Suez Canal Convoy Queue Congestion\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/shipments/{{shipment_id}}",
              "host": ["{{base_url}}"],
              "path": ["shipments", "{{shipment_id}}"]
            }
          }
        }
      ]
    },
